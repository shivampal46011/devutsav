FROM node:20-alpine AS builder
WORKDIR /app/sattva-qwik
COPY sattva-qwik/package.json sattva-qwik/package-lock.json* ./
RUN npm install
COPY sattva-qwik/ ./
RUN npm run build.prod

FROM node:20-alpine
WORKDIR /app/sattva-qwik
ENV NODE_ENV=production
# Full source + dev deps retained so the entrypoint can run SSG (build.static)
# at container startup, when the `api` service is reachable on the docker network.
COPY --from=builder /app/sattva-qwik/ ./
EXPOSE 3000
ENV PORT=3000
COPY sattva-qwik/scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
CMD ["/entrypoint.sh"]
