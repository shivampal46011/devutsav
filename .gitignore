# Dependencies
node_modules/

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Build output
dist/
dist-ssr/
.output/
server/

# Logs (anchor to the actual log-output dirs — an unanchored `logs/` also matched
# source folders like sattva-qwik/src/routes/admin/logs and broke the deploy upload)
/logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Agent runtime state (logs/tickets/runs/campaign are local text files, not committed)
agent/logs/
agent/tickets/
agent/runs.jsonl
agent/content/campaign.jsonl
agent/content/CALENDAR.md
agent/state/
agent/reports/
agent/secrets/

# Lock files (keep bun.lock or package-lock.json, not both)
package-lock.json

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
*.local
.cache/
tmp/
*.tsbuildinfo

# User-uploaded media (served from disk volume in prod)
backend/src/public/uploads/

# Local-only deploy + secret docs (contain plaintext credentials)
SERVER.md
deploy.sh
